<#@ template debug="true" hostSpecific="true" #>
<#
    SpNameGenerator.Host = Host;
#>
<#@ import namespace="System" #>

<#+
	class SpNameGenerator
	{
		private const string SpNameTemplate = "SpName=\"{0}\"";

		public static ITextTemplatingEngineHost Host { get; set; }

		private string _environment;

		public SpNameGenerator(string environment)
		{
			_environment = environment;
		}

		public string Generate(string allSpNames, IEnumerable<SpNameConfig> spNameConfigList)
		{
			spNameConfigList = spNameConfigList.Where(p => p.Environment == _environment).ToList();
			var generatedText = allSpNames;

			foreach(var item in spNameConfigList)
			{
				generatedText = Regex.Replace(
					generatedText,
					string.Format(SpNameTemplate, item.SpName),
					string.Format(SpNameTemplate, item.SpName + item.Suffix),
					RegexOptions.IgnoreCase
				);
			}

			return generatedText;
		}
	}
#>
<#+
	class SpNameConfig
	{
		public string Environment {get;set;}

		public string SpName {get;set;}

		public string Suffix {get;set;}
	}
#>
<#+
	static class Helper
	{
		public static string GetAllSpName()
		{
			return System.IO.File.ReadAllText(@"Fanex.Affiliate.WebServices\App_Data\SpNames\SpNameOriginal.xml");
		}

		public static System.Collections.Generic.List<SpNameConfig> GetListOfSpConfig()
		{
			var document = System.Xml.Linq.XDocument.Load(@"Fanex.Affiliate.WebServices\App_Data\SpNames\SpNameConfig.xml");
			var elements = document.Root.Elements("SpNameConfig");
			var spNameConfigList = new System.Collections.Generic.List<SpNameConfig>();

			foreach(var element in elements)
			{
				var environments = element.Attribute("Environment").Value.Trim().Split(',');

				foreach(var environment in environments)
				{
					spNameConfigList.Add(new SpNameConfig{
						Environment = environment.Trim().ToLower(),
						SpName = element.Attribute("SpName").Value.Trim(),
						Suffix = element.Attribute("Suffix").Value.Trim()
					});
				}
			}

			return spNameConfigList;
		}
	}
#>